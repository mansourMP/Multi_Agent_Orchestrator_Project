# Backend Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/agentforge_dev"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Application
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Authentication
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_EXPIRATION="7d"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:4000/api/v1/auth/github/callback"

# LLM Providers
OPENAI_API_KEY="sk-..."
OPENAI_ORGANIZATION=""

ANTHROPIC_API_KEY="sk-ant-..."

# n8n Integration
N8N_API_URL="http://localhost:5678/api/v1"
N8N_API_KEY="your-n8n-api-key"
N8N_WEBHOOK_SECRET="your-webhook-secret-for-signatures"

# Billing (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="AgentForge <noreply@agentforge.app>"

# Observability
LOG_LEVEL="debug"
SENTRY_DSN=""

# Security
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="1000"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# AWS (for production)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# Feature Flags
ENABLE_SIGNUP="true"
ENABLE_OAUTH="true"
ENABLE_AI_BUILDER="true"
