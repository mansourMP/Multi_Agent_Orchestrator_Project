{
  "name": "empyralis-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Empyralis AGI Workbench desktop shell",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack:mac": "electron-builder --mac dmg zip",
    "pack:win": "electron-builder --win nsis portable",
    "pack:linux": "electron-builder --linux AppImage deb",
    "pack:all": "electron-builder -mwl",
    "pack:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "39.6.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.empyralis.workbench",
    "productName": "Empyralis Workbench",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "browser_task.js"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
