{
  "productName": "Empyralis",
  "version": "0.1.0",
  "identifier": "com.empyralis.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../frontend/.next",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Empyralis",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/512x512.png"
    ],
    "externalBin": ["../dist/empyralis-backend"],
    "resources": ["../frontend/app/favicon.ico"]
  }
}
